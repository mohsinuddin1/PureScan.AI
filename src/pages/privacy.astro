---
import { getTranslations } from '../lib/i18n-utils';
import Layout from '../layouts/Layout.astro';
import PrivacyPolicy from '../components/privacy.jsx';
const lang = Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
import { PrivacyIsland } from '../components/Islands.jsx';
---
<Layout title="Privacy Policy — Klar Scanner" description="Read Klar's Privacy Policy. Learn how your personal data, scan history, and health preferences are protected with strict privacy standards.">
  <PrivacyIsland client:load  lang={lang} translations={translations} />
</Layout>
