---
import { getTranslations } from '../lib/i18n-utils';
import Layout from '../layouts/Layout.astro';
import { DeleteAccountIsland } from '../components/Islands.jsx';

const lang = Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
---
<Layout title="Delete Account - PureScan AI">
  <DeleteAccountIsland client:load  lang={lang} translations={translations} />
</Layout>
