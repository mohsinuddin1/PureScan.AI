---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import mascotHappy from '../assets/mascot-happy.png';
import logoImg from '../assets/logo.png';

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.id.startsWith('en/'))
  .filter(p => ['Food Safety', 'Ingredient Safety', 'Health & Nutrition'].includes(p.data.badge))
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .slice(0, 6);

const faqs = [
  {
    question: "What is the best food scanner app?",
    answer: "PureScan AI is the most advanced food scanner app in 2026. It combines barcode scanning with AI-powered ingredient analysis, provides Nutri-Score and NOVA processing classifications, and gives personalized health risk assessments based on your individual health conditions, allergies, and dietary preferences. Free on iOS and Android."
  },
  {
    question: "How does a food scanner app work?",
    answer: "A food scanner app uses your phone's camera to scan product barcodes or ingredient labels. PureScan AI then cross-references each ingredient against scientific databases to detect harmful additives, allergens, ultra-processed ingredients, and chemicals linked to health issues. Results are personalized to your specific health conditions."
  },
  {
    question: "What is Nutri-Score and NOVA classification?",
    answer: "Nutri-Score rates food nutritional quality from A (best) to E (worst) based on nutrients, calories, and composition. NOVA classification rates food processing level from 1 (unprocessed) to 4 (ultra-processed). PureScan AI shows both scores automatically for every food product you scan."
  },
  {
    question: "Can PureScan AI detect ultra-processed foods?",
    answer: "Yes. PureScan AI identifies ultra-processed foods (NOVA 4) by detecting emulsifiers, artificial sweeteners, modified starches, hydrogenated oils, flavor enhancers, and other markers of industrial food processing that are linked to obesity, diabetes, and chronic inflammation."
  },
  {
    question: "Does the food scanner detect allergens?",
    answer: "PureScan AI detects 14+ major allergen categories including gluten, dairy, lactose, nuts, peanuts, soy, shellfish, eggs, sesame, mustard, celery, lupin, mollusks, and sulfites — plus hidden derivatives that often go unnoticed on ingredient labels."
  },
  {
    question: "Can I scan food products from any country?",
    answer: "Yes. PureScan AI has a massive global product database, and its AI camera reads ingredient labels in all world languages. You can scan imported foods, international groceries, and products purchased while traveling abroad."
  }
];
---

<Layout
  title="Food Scanner App — AI Barcode Scanner for Hidden Toxins & Allergens | PureScan AI"
  shortTitle="Best Food Scanner App 2026 — Nutri-Score & NOVA | PureScan AI"
  description="Scan food barcodes to detect hidden toxins, allergens, ultra-processed additives, and get Nutri-Score & NOVA ratings instantly. Personalized to your health. Free on iOS & Android."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "FAQPage",
        "mainEntity": faqs.map(f => ({
          "@type": "Question",
          "name": f.question,
          "acceptedAnswer": { "@type": "Answer", "text": f.answer }
        }))
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://purescan.droploop.in/#app",
        "name": "PureScan AI",
        "applicationCategory": "HealthApplication",
        "applicationSubCategory": "Food Scanner",
        "operatingSystem": "iOS, Android",
        "description": "AI-powered food scanner app that provides Nutri-Score, NOVA ultra-processing classification, allergen detection, and personalized health risk assessments.",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "aggregateRating": { "@type": "AggregateRating", "ratingValue": "4.8", "ratingCount": "500", "bestRating": "5" },
        "featureList": "Nutri-Score grading, NOVA classification, Barcode scanning, AI camera label reading, Allergen detection, Ultra-processed food detection, Personalized health assessment"
      },
      {
        "@type": "HowTo",
        "name": "How to scan food for hidden toxins and allergens",
        "description": "Use PureScan AI to scan food product barcodes and ingredient labels to detect harmful additives, allergens, and ultra-processed ingredients.",
        "step": [
          { "@type": "HowToStep", "position": 1, "name": "Scan the barcode", "text": "Open PureScan AI and point your phone camera at any food product barcode. If the barcode isn't recognized, use the AI camera to photograph the ingredient label." },
          { "@type": "HowToStep", "position": 2, "name": "Review the analysis", "text": "PureScan AI instantly shows you Nutri-Score (A-E), NOVA processing level (1-4), detected allergens, harmful additives, and ingredient-level safety ratings." },
          { "@type": "HowToStep", "position": 3, "name": "Get personalized results", "text": "Based on your health profile (allergies, conditions like PCOS or diabetes), PureScan AI highlights ingredients that are specifically harmful to you." }
        ]
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://purescan.droploop.in/" },
          { "@type": "ListItem", "position": 2, "name": "Food Scanner App" }
        ]
      }
    ]
  })} />

  <div class="min-h-screen bg-white text-slate-800 font-sans">
    <nav class="w-full bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 md:px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <Image src={logoImg} alt="PureScan AI" format="webp" loading="eager" class="w-8 h-8 object-contain" />
          <span class="font-extrabold tracking-tight text-xl italic text-[#17C37B]">PureScan AI</span>
        </a>
        <div class="flex items-center gap-3">
          <a href="/blog" class="text-sm font-medium text-slate-500 hover:text-slate-800 transition-colors hidden sm:inline">Blog</a>
          <a href="/ingredient-scanner" class="text-sm font-medium text-slate-500 hover:text-slate-800 transition-colors hidden sm:inline">Ingredients</a>
          <a href="https://apps.apple.com/app/pure-ai/id6762176490" target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 bg-slate-900 text-white px-4 py-2 rounded-full text-sm font-bold hover:scale-105 transition-transform">
            Download Free
          </a>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <section class="py-16 md:py-28 px-4 md:px-6 max-w-6xl mx-auto">
      <div class="flex flex-col md:flex-row items-center gap-12 md:gap-16">
        <div class="w-full md:w-1/2 text-center md:text-left">
          <span class="inline-block py-1 px-3 rounded-full bg-emerald-100 text-[#17C37B] text-xs font-bold tracking-widest uppercase mb-4">Food Scanner App</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 mb-6 leading-[1.1]">
            Scan Food <span class="text-[#17C37B]">Barcodes</span> to Detect Hidden Toxins & Allergens
          </h1>
          <p class="text-lg md:text-xl text-slate-600 font-medium leading-relaxed mb-8">
            PureScan AI is the smartest food scanner app for iOS and Android. Scan any food barcode or photograph the ingredient label to instantly get Nutri-Score, NOVA ultra-processing classification, allergen alerts, and personalized health risk assessments based on your unique health profile.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4">
            <a href="https://apps.apple.com/app/pure-ai/id6762176490" target="_blank" rel="noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#0A0A0A] text-white px-7 py-3.5 rounded-full text-lg font-bold hover:scale-105 hover:shadow-2xl transition-all shadow-lg">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M15.4 7.6c.4-.6.8-1.5.8-2.3 0-.1 0-.2-.1-.3-.8.1-1.8.5-2.5 1-.6.5-1.1 1.4-1.1 2.2 0 .1.1.2.1.2.8 0 1.8-.4 2.8-.8zm.5 1.5c-1.3 0-2.6.9-3.4.9s-1.8-.8-3-.8c-1.6 0-3 .9-3.9 2.3-1.8 2.8-.5 7 .1 8.1.6.9 1.4 2 2.4 1.9.9-.1 1.4-.7 2.6-.7s1.6.7 2.6.7c1.1.1 1.7-.9 2.4-1.9.8-1.1 1.2-2.3 1.2-2.3s-2.1-.8-2.2-3.3c-.1-2.1 1.7-3.1 1.7-3.2-1-1.4-2.5-1.6-3-1.7z" /></svg>
              App Store
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.pureai.com&hl=en_GB&referrer=utm_source%3Dpurescanai_website%26utm_medium%3Dlanding_food%26utm_campaign%3Dseo" target="_blank" rel="noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#17C37B] text-white px-7 py-3.5 rounded-full text-lg font-bold hover:scale-105 transition-transform shadow-xl shadow-[#17C37B]/30">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M15.5 12.5a1 1 0 01-1-1 1 1 0 011-1 1 1 0 011 1 1 1 0 01-1 1zm-7 0a1 1 0 01-1-1 1 1 0 011-1 1 1 0 011 1 1 1 0 01-1 1zm12.3-5.2l1.6-2.8a.4.4 0 00-.2-.6.4.4 0 00-.5.1L20.2 7A9.4 9.4 0 0012 4.6c-3 0-5.7 1.4-7.4 3.5a.5.5 0 000 0l-1.5-2.7a.4.4 0 00-.6-.1c-.2.2-.3.4-.2.6l1.6 2.8A9.7 9.7 0 002 15h20a9.8 9.8 0 00-1.2-7.7z" /></svg>
              Google Play
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-400 font-medium">Free · Nutri-Score · NOVA · 14+ Allergens</p>
        </div>
        <div class="w-full md:w-1/2 flex justify-center">
          <Image src={mascotHappy} alt="PureScan AI food scanner mascot" format="webp" loading="eager" fetchpriority="high" class="w-full max-w-[300px] drop-shadow-2xl" />
        </div>
      </div>
    </section>

    <!-- Scoring Systems -->
    <section class="py-16 md:py-24 px-4 md:px-6 bg-slate-50 border-y border-slate-100">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-black text-slate-800 mb-4">Food Safety Scoring Systems</h2>
          <p class="text-lg text-slate-600 font-medium">PureScan AI uses scientifically-backed scoring systems to rate every food product.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm">
            <h3 class="text-2xl font-black text-slate-800 mb-4">Nutri-Score (A–E)</h3>
            <p class="text-slate-600 font-medium mb-6 leading-relaxed">The European nutritional quality grading system. PureScan AI calculates Nutri-Score based on positive factors (fiber, protein, fruits, vegetables) and negative factors (calories, sugar, saturated fat, sodium) to give each food a letter grade from A (healthiest) to E.</p>
            <div class="flex gap-2">
              {['A', 'B', 'C', 'D', 'E'].map((letter, i) => (
                <span class={`w-10 h-10 rounded-xl flex items-center justify-center font-black text-white text-sm ${
                  i === 0 ? 'bg-green-500' : i === 1 ? 'bg-lime-500' : i === 2 ? 'bg-yellow-500' : i === 3 ? 'bg-orange-500' : 'bg-red-500'
                }`}>{letter}</span>
              ))}
            </div>
          </div>
          <div class="bg-white p-8 rounded-3xl border border-slate-100 shadow-sm">
            <h3 class="text-2xl font-black text-slate-800 mb-4">NOVA Classification (1–4)</h3>
            <p class="text-slate-600 font-medium mb-6 leading-relaxed">The NOVA food processing classification system rates how processed a food is. Group 1 (unprocessed), Group 2 (processed culinary ingredients), Group 3 (processed foods), and Group 4 (ultra-processed) — linked to obesity, diabetes, and cancer risk.</p>
            <div class="flex gap-2">
              {['1', '2', '3', '4'].map((num, i) => (
                <span class={`w-10 h-10 rounded-xl flex items-center justify-center font-black text-white text-sm ${
                  i === 0 ? 'bg-green-500' : i === 1 ? 'bg-yellow-500' : i === 2 ? 'bg-orange-500' : 'bg-red-500'
                }`}>{num}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- What Gets Flagged -->
    <section class="py-16 md:py-24 px-4 md:px-6 max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-slate-800 mb-4">Hidden Dangers PureScan AI Finds in Your Food</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { icon: "🧪", title: "Ultra-Processed Additives", desc: "Emulsifiers (polysorbate 80, carboxymethyl cellulose), modified starches, and hydrogenated oils linked to gut inflammation and metabolic syndrome." },
          { icon: "🎨", title: "Synthetic Food Dyes", desc: "Red 40, Yellow 5, Yellow 6, Blue 1, and other artificial colorings linked to hyperactivity in children and banned in parts of Europe." },
          { icon: "🤧", title: "Hidden Allergens", desc: "Casein, whey, maltodextrin (potential gluten), sodium caseinate, and other ingredients that disguise common allergens under chemical names." },
          { icon: "⚠️", title: "Harmful Preservatives", desc: "BHT, BHA, sodium benzoate, potassium sorbate, and nitrates/nitrites — preservatives with documented health concerns from long-term exposure." },
        ].map(item => (
          <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-xl transition-all flex gap-4">
            <div class="text-3xl shrink-0">{item.icon}</div>
            <div>
              <h3 class="text-lg font-bold text-slate-800 mb-2">{item.title}</h3>
              <p class="text-slate-600 font-medium text-sm leading-relaxed">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-16 md:py-24 px-4 md:px-6 bg-slate-50 border-y border-slate-100" id="faq">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-black text-slate-800 mb-4">Frequently Asked Questions</h2>
        </div>
        <div class="space-y-4">
          {faqs.map(faq => (
            <details class="group bg-white border border-slate-100 rounded-2xl shadow-sm hover:shadow-md transition-shadow">
              <summary class="p-6 cursor-pointer flex items-center justify-between gap-4 font-bold text-slate-800 text-lg select-none">
                {faq.question}
                <svg class="w-5 h-5 shrink-0 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <div class="px-6 pb-6 text-slate-600 font-medium leading-relaxed -mt-2">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="py-16 md:py-24 px-4 md:px-6">
        <div class="max-w-6xl mx-auto">
          <div class="text-center mb-10">
            <h2 class="text-2xl md:text-3xl font-black text-slate-800 mb-2">Learn More About Food Safety</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map(post => (
              <a href={`/blog/${post.id.split('/')[1]}`} class="group bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-sm hover:shadow-xl transition-all flex flex-col">
                {post.data.image && (
                  <div class="aspect-video w-full overflow-hidden bg-slate-100">
                    <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                  </div>
                )}
                <div class="p-5 flex-grow">
                  <span class="text-[#17C37B] text-xs font-bold uppercase tracking-widest mb-2">{post.data.badge}</span>
                  <h3 class="text-base font-bold text-slate-800 group-hover:text-[#17C37B] transition-colors line-clamp-2 mt-1">{post.data.title}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <section class="py-20 md:py-28 px-4 md:px-6 text-center bg-slate-50 border-t border-slate-100">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-black text-slate-800 mb-4">Know What You're Really Eating</h2>
        <p class="text-lg text-slate-600 font-medium mb-8">Download PureScan AI free — the most advanced food scanner app available.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="https://apps.apple.com/app/pure-ai/id6762176490" target="_blank" rel="noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#0A0A0A] text-white px-8 py-4 rounded-full text-lg font-bold hover:scale-105 transition-all shadow-lg">Download for iOS</a>
          <a href="https://play.google.com/store/apps/details?id=com.pureai.com&hl=en_GB&referrer=utm_source%3Dpurescanai_website%26utm_medium%3Dlanding_food%26utm_campaign%3Dseo" target="_blank" rel="noreferrer" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-[#17C37B] text-white px-8 py-4 rounded-full text-lg font-bold hover:scale-105 transition-transform shadow-xl shadow-[#17C37B]/30">Download for Android</a>
        </div>
      </div>
    </section>

    <footer class="py-12 bg-white border-t-2 border-slate-100">
      <div class="max-w-7xl mx-auto px-6 text-center">
        <div class="flex justify-center items-center gap-2 mb-6">
          <Image src={logoImg} alt="PureScan AI" format="webp" loading="lazy" class="w-8 h-8 object-contain grayscale opacity-50" />
          <span class="font-extrabold tracking-tight text-xl italic text-slate-300">PureScan AI</span>
        </div>
        <p class="text-slate-500 font-medium pb-4 text-sm flex flex-wrap justify-center items-center gap-y-2">
          <a href="/" class="hover:text-[#17C37B] transition-colors">Home</a><span class="mx-3">•</span>
          <a href="/ingredient-scanner" class="hover:text-[#17C37B] transition-colors">Ingredient Scanner</a><span class="mx-3">•</span>
          <a href="/cosmetic-safety-checker" class="hover:text-[#17C37B] transition-colors">Cosmetic Checker</a><span class="mx-3">•</span>
          <a href="/allergy-scanner" class="hover:text-[#17C37B] transition-colors">Allergy Scanner</a><span class="mx-3">•</span>
          <a href="/blog" class="hover:text-[#17C37B] transition-colors">Blog</a><span class="mx-3">•</span>
          <a href="/privacy" class="hover:text-[#17C37B] transition-colors">Privacy</a>
        </p>
        <p class="text-slate-400 font-medium text-xs">&copy; {new Date().getFullYear()} PureScan AI.</p>
      </div>
    </footer>
  </div>
</Layout>
