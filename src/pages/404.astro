---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.jsx';
---

<Layout
  title="Page Not Found | Klar"
  description="The page you are looking for could not be found. Explore Klar food and cosmetic ingredient scanner guides and tools."
  noindex={true}
>
  <div class="min-h-screen flex flex-col bg-white text-slate-800 font-sans">
    <Navbar client:load />

    <main class="flex-1 flex items-center justify-center px-5 py-16 md:py-24">
      <div class="max-w-xl w-full text-center bg-slate-50 border border-slate-100 rounded-[2rem] p-8 sm:p-12 shadow-sm">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-emerald-100 text-[#17C37B] font-black text-2xl mb-6">
          404
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 mb-4">Page Not Found</h1>
        <p class="text-slate-600 font-medium leading-relaxed mb-8">
          The page you requested may have moved or no longer exists. Explore our ingredient safety tools and guides below.
        </p>

        <div class="flex flex-col sm:flex-row gap-3 justify-center mb-8">
          <a href="/" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#17C37B] text-white font-bold hover:opacity-95 transition-opacity">
            Go to Homepage
          </a>
          <a href="/blog" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-slate-900 text-white font-bold hover:bg-slate-800 transition-colors">
            Read Health Blog
          </a>
        </div>

        <div class="pt-6 border-t border-slate-200 flex flex-wrap justify-center gap-4 text-sm font-semibold text-[#17C37B]">
          <a href="/ingredient-scanner" class="hover:underline">Ingredient Scanner</a>
          <a href="/food-scanner-app" class="hover:underline">Food Scanner App</a>
          <a href="/cosmetic-safety-checker" class="hover:underline">Cosmetic Safety Checker</a>
        </div>
      </div>
    </main>
  </div>
</Layout>
