---
import { getTranslations } from '../../lib/i18n-utils';
import Layout from '../../layouts/Layout.astro';
import { AlternativeIsland } from '../../components/Islands.jsx';
import { getCompetitor } from '../../data/competitorData.js';

const lang = Astro.currentLocale || 'en';
const translations = await getTranslations(lang);

export function getStaticPaths() {
  return [
    {params: {competitor: 'yuka'}},
    {params: {competitor: 'clearya'}},
    {params: {competitor: 'ewg'}},
    {params: {competitor: 'think-dirty'}},
    {params: {competitor: 'trash-panda'}},
    {params: {competitor: 'incibeauty'}},
    {params: {competitor: 'bobby-approved'}},
  ];
}

const { competitor } = Astro.params;
const compData = getCompetitor(competitor);
const name = compData.name;

const pageTitle = `Klar vs ${name} — The Best Alternative`;
const pageDesc = `Klar vs ${name}: Compare features and see why Klar is the top AI food and cosmetic scanner for detecting hidden toxins, allergens, and additives.`;

const siteUrl = 'https://scaningredients.com';
const pageUrl = `${siteUrl}/alternatives/${competitor}`;

const faqSchemaItems = (compData.faqs || []).map(f => ({
  "@type": "Question",
  "name": f.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": f.answer
  }
}));

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Klar",
      "alternateName": ["PureScan AI", "Klar AI"],
      "applicationCategory": "HealthApplication",
      "operatingSystem": "iOS, Android",
      "url": "https://scaningredients.com/",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "1420",
        "bestRating": "5",
        "worstRating": "1"
      },
      "description": `Klar is the leading AI-powered food and cosmetic scanner app, offering personalized toxin alerts, allergy detection, and camera label OCR as an alternative to ${name}.`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Alternatives",
          "item": `${siteUrl}/alternatives/${competitor}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `Klar vs ${name}`
        }
      ]
    },
    ...(faqSchemaItems.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqSchemaItems
    }] : [])
  ]
};
---
<Layout title={pageTitle} description={pageDesc}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <AlternativeIsland client:load lang={lang} translations={translations} competitor={competitor} />
</Layout>
