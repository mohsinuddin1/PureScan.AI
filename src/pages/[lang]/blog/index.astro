---
export function getStaticPaths() {
  const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  return locales.map(lang => ({ params: { lang } }));
}

import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import Navbar from '../../../components/Navbar.jsx';
import { Image } from 'astro:assets';
import logoImg from '../../../assets/logo.png';
import { useTranslations } from '../../../lib/i18n-utils';

const lang = Astro.params.lang || Astro.currentLocale || 'en';
const t = useTranslations(lang);
const currentBlogPosts = await getCollection('blog', ({ id }) => id.toLowerCase().startsWith(`${lang.toLowerCase()}/`));

// Generate ItemList schema for rich results
const blogItems = currentBlogPosts.map((post, index) => ({
  "@type": "ListItem",
  "position": index + 1,
  "url": `https://purescan.droploop.in/${lang}/blog/${post.id.split('/')[1]}`,
  "name": post.data.title
}));

const metaTitle = t('blog.metaTitle', 'Klar Blog — Hidden Toxins in Food & Cosmetics');
const metaShortTitle = t('blog.metaShortTitle', 'Health Blog — Hidden Toxins in Food & Skincare | Klar');
const metaDescription = t('blog.metaDescription', 'Expert articles on hidden toxins, allergens, and endocrine disruptors in everyday food and cosmetic products. Backed by PubMed research.');
const backText = t('common.back', 'Back');
const brandBlog = t('blog.brandBlog', 'Klar Blog');
const hubTitle = t('blog.hubTitle', 'The Health Hub');
const hubSubtitle = t('blog.hubSubtitle', 'Your trusted guide to understanding food labels, decoding cosmetics, and making healthier choices backed by scientific data.');
const gradingText = t('footer.grading', 'Grading System');
const blogText = t('footer.blog', 'Blog');
const privacyText = t('footer.privacy', 'Privacy Policy');
const termsText = t('footer.terms', 'Terms of Service');
const supportText = t('footer.support', 'Support');
const copyright = (t('footer.copyright', '© {year} Klar (formerly PureScan AI). Food & Cosmetic Scanner. All rights reserved.')).replace(/\{year\}/g, new Date().getFullYear());
---

<Layout 
  title={metaTitle}
  shortTitle={metaShortTitle}
  description={metaDescription}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": brandBlog,
    "description": metaDescription,
    "url": `https://purescan.droploop.in/${lang}/blog`,
    "isPartOf": {
      "@id": "https://purescan.droploop.in/#website"
    },
    "mainEntity": {
      "@type": "ItemList",
      "itemListElement": blogItems
    }
  })} />
  <div class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased selection:bg-slate-200" dir={lang === 'ar' || lang === 'ar-MA' ? 'rtl' : 'ltr'}>
    <Navbar client:load currentLang={lang} showBack={true} backUrl={lang === 'en' ? '/' : `/${lang}`} backText={backText} />

    <main class="px-5 py-12 md:py-20 max-w-5xl mx-auto min-h-[70vh]">
      <header class="mb-12 text-center sm:text-left max-w-3xl">
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 mb-4">
              {hubTitle}
          </h1>
          <p class="text-lg text-slate-500 font-medium leading-relaxed">
              {hubSubtitle}
          </p>
      </header>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8">
          {currentBlogPosts.map((post) => {
              const slug = post.id.split('/')[1];
              return (
              <a 
                  href={lang === 'en' ? `/blog/${slug}` : `/${lang}/blog/${slug}`}
                  class="group relative h-[450px] sm:h-[500px] rounded-3xl overflow-hidden cursor-pointer shadow-md hover:shadow-2xl transition-all duration-300 block"
              >
                  <div 
                      class="absolute inset-0 bg-cover bg-center transform group-hover:scale-105 transition-transform duration-700 ease-out"
                      style={{ backgroundImage: `url(${post.data.image})` }}
                  ></div>
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/10 transition-opacity duration-300"></div>
                  
                  <div class="absolute inset-0 p-6 sm:p-8 flex flex-col justify-end">
                      <div class="bg-white/90 backdrop-blur-md px-3 py-1.5 rounded-full text-xs font-bold text-slate-900 w-fit mb-4 shadow-sm">
                          {post.data.badge}
                      </div>
                      <h2 class="text-2xl sm:text-3xl font-bold text-white mb-3 leading-snug drop-shadow-sm">
                          {post.data.title}
                      </h2>
                      <p class="text-slate-200 text-sm sm:text-base line-clamp-3 font-medium">
                          {post.data.description}
                      </p>
                  </div>
              </a>
          )})}
      </div>
    </main>

    <footer class="py-12 bg-white border-t-2 border-slate-100">
        <div class="max-w-7xl mx-auto px-6 text-center">
          <div class="flex justify-center items-center gap-2 mb-6">
            <Image src={logoImg} alt="Klar" format="webp" loading="lazy" class="w-8 h-8 object-contain grayscale opacity-50" />
            <span class="font-extrabold tracking-tight text-xl italic text-slate-300">Klar</span>
          </div>
          <p class="text-slate-500 font-medium pb-4 text-sm flex flex-wrap justify-center items-center gap-y-2">
            <a href={lang === 'en' ? '/grading' : `/${lang}/grading`} class="hover:text-[#17C37B] transition-colors">{gradingText}</a>
            <span class="mx-3 hidden md:inline">•</span>
            <a href={lang === 'en' ? '/blog' : `/${lang}/blog`} class="hover:text-[#17C37B] transition-colors ml-3 md:ml-0">{blogText}</a>
            <span class="mx-3">•</span>
            <a href={lang === 'en' ? '/privacy' : `/${lang}/privacy`} class="hover:text-[#17C37B] transition-colors">{privacyText}</a>
            <span class="mx-3">•</span>
            <a href={lang === 'en' ? '/terms' : `/${lang}/terms`} class="hover:text-[#17C37B] transition-colors">{termsText}</a>
            <span class="mx-3">•</span>
            <a href={lang === 'en' ? '/support' : `/${lang}/support`} class="hover:text-[#17C37B] transition-colors">{supportText}</a>
          </p>
          <p class="text-slate-400 font-medium text-xs">{copyright}</p>
        </div>
    </footer>
  </div>
</Layout>
