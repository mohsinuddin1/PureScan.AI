---
export function getStaticPaths() {
  const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  return locales.map(lang => ({ params: { lang } }));
}

import { getTranslations } from '../../lib/i18n-utils';
import Layout from '../../layouts/Layout.astro';
import TermsOfService from '../../components/Terms.jsx';

const lang = Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
import { TermsIsland } from '../../components/Islands.jsx';
const metaTitle = translations?.terms?.pageMetaTitle || "Terms of Service — Klar Scanner";
const metaDesc = translations?.terms?.pageMetaDesc || "Read the Terms of Service for Klar (formerly PureScan AI). Understand the terms, conditions, and user guidelines for our scanner app.";
---
<Layout title={metaTitle} description={metaDesc}>
  <TermsIsland client:load  lang={lang} translations={translations} />
</Layout>
