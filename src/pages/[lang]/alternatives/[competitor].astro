---
import { getTranslations } from '../../../lib/i18n-utils';
import Layout from '../../../layouts/Layout.astro';
import Alternative from '../../../components/Alternative.jsx';
import { AlternativeIsland } from '../../../components/Islands.jsx';

export function getStaticPaths() {
  const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  const comps = [
    {params: {competitor: 'yuka'}},
    {params: {competitor: 'clearya'}},
    {params: {competitor: 'ewg'}},
    {params: {competitor: 'think-dirty'}},
    {params: {competitor: 'trash-panda'}},
    {params: {competitor: 'incibeauty'}},
    {params: {competitor: 'bobby-approved'}},
  ];
  const paths = [];
  for (const lang of locales) {
      for (const c of comps) {
          paths.push({ params: { lang, competitor: c.params.competitor } });
      }
  }
  return paths;
}

const lang = Astro.params.lang || Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
const { competitor } = Astro.params;
const name = competitor ? competitor.charAt(0).toUpperCase() + competitor.slice(1) : 'Competitor';

const pageTitle = (translations?.alternatives?.pageMetaTitle || `Klar vs ${name} — The Best Alternative`).replace(/\{name\}/g, name);
const pageDesc = (translations?.alternatives?.pageMetaDesc || `Klar vs {name}: AI food and cosmetic scanner. Detect hidden toxins, allergens, and harmful additives. Free on iOS and Android.`).replace(/\{name\}/g, name);
---
<Layout title={pageTitle} description={pageDesc}>
  <AlternativeIsland client:load lang={lang} translations={translations} competitor={competitor} />
</Layout>
