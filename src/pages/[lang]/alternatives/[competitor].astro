---
import { getTranslations } from '../../../lib/i18n-utils';
import Layout from '../../../layouts/Layout.astro';
import { AlternativeIsland } from '../../../components/Islands.jsx';
import { getCompetitor } from '../../../data/competitorData.js';

const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];

export function getStaticPaths() {
  const allLocales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  const comps = [
    {params: {competitor: 'yuka'}},
    {params: {competitor: 'clearya'}},
    {params: {competitor: 'ewg'}},
    {params: {competitor: 'think-dirty'}},
    {params: {competitor: 'trash-panda'}},
    {params: {competitor: 'incibeauty'}},
    {params: {competitor: 'bobby-approved'}},
  ];
  const paths = [];
  for (const lang of allLocales) {
      for (const c of comps) {
          paths.push({ params: { lang, competitor: c.params.competitor } });
      }
  }
  return paths;
}

const lang = Astro.params.lang || Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
const { competitor } = Astro.params;
const compData = getCompetitor(competitor);
const name = compData.name;

const pageTitle = (translations?.alternatives?.pageMetaTitle || `Klar vs ${name} — The Best Alternative`).replace(/\{name\}/g, name);
const pageDesc = (translations?.alternatives?.pageMetaDesc || `Klar vs {name}: In-depth comparison. Discover why Klar is the top AI food & cosmetic scanner for hidden toxins, allergens, and additives.`).replace(/\{name\}/g, name);

const siteUrl = 'https://purescan.droploop.in';
const pageUrl = `${siteUrl}/${lang}/alternatives/${competitor}`;

// Build hreflang alternate URLs
const alternateUrls: Record<string, string> = {
  en: `${siteUrl}/alternatives/${competitor}`
};
for (const loc of locales) {
  alternateUrls[loc] = `${siteUrl}/${loc}/alternatives/${competitor}`;
}

const faqSchemaItems = (compData.faqs || []).map(f => ({
  "@type": "Question",
  "name": f.question,
  "acceptedAnswer": {
    "@type": "Answer",
    "text": f.answer
  }
}));

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Klar",
      "alternateName": ["PureScan AI", "Klar AI"],
      "applicationCategory": "HealthApplication",
      "operatingSystem": "iOS, Android",
      "url": "https://purescan.droploop.in/",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "1420",
        "bestRating": "5",
        "worstRating": "1"
      },
      "description": `Klar is the leading AI-powered food and cosmetic scanner app, offering personalized toxin alerts, allergy detection, and camera label OCR as an alternative to ${name}.`
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/${lang}`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Alternatives",
          "item": `${siteUrl}/${lang}/alternatives/${competitor}`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": `Klar vs ${name}`
        }
      ]
    },
    ...(faqSchemaItems.length > 0 ? [{
      "@type": "FAQPage",
      "mainEntity": faqSchemaItems
    }] : [])
  ]
};
---
<Layout title={pageTitle} description={pageDesc} alternateUrls={alternateUrls}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  <AlternativeIsland client:load lang={lang} translations={translations} competitor={competitor} />
</Layout>
