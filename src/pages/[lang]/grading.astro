---
export function getStaticPaths() {
  const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  return locales.map(lang => ({ params: { lang } }));
}

import { getTranslations } from '../../lib/i18n-utils';
import Layout from '../../layouts/Layout.astro';
import Grading from '../../components/Grading.jsx';
const lang = Astro.params.lang || Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
import { GradingIsland } from '../../components/Islands.jsx';
const metaTitle = translations?.grading?.pageMetaTitle || (translations?.pageTitle ? `${translations.pageTitle} | Klar` : "Grading System — Scientific Health & Toxicity Scores | Klar");
const metaDesc = translations?.grading?.pageMetaDesc || translations?.introPara1 || "Explore Klar's scientific grading system for food and cosmetics. Learn how AI calculates toxicity hazard scores, Nutri-Score, and NOVA ratings.";
---
<Layout title={metaTitle} description={metaDesc}>
  <GradingIsland client:load  lang={lang} translations={translations} />
</Layout>
