---
export function getStaticPaths() {
  const locales = ["ar","ar-MA","bg","cs","da","de","el","es","fi","fr","hu","it","ja","ko","lt","lv","nb","nl","no","pl","pt","ro","ru","sv","tr","zh"];
  return locales.map(lang => ({ params: { lang } }));
}

import { getTranslations } from '../../lib/i18n-utils';
import Layout from '../../layouts/Layout.astro';
import { DeleteAccountIsland } from '../../components/Islands.jsx';

const lang = Astro.params.lang || Astro.currentLocale || 'en';
const translations = await getTranslations(lang);
const metaTitle = translations?.deleteAccount?.pageMetaTitle || 'Delete Account - Klar (formerly PureScan AI)';
const metaDesc = translations?.deleteAccount?.pageMetaDesc || 'Instructions on how to delete your Klar (formerly PureScan AI) account and permanently purge your data.';
---
<Layout title={metaTitle} description={metaDesc}>
  <DeleteAccountIsland client:load lang={lang} translations={translations} />
</Layout>
