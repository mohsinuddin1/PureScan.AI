---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';
import Navbar from '../../components/Navbar.jsx';
import { Image } from 'astro:assets';
import mascotHappy from '../../assets/mascot-happy.png';
import logoImg from '../../assets/logo.png';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Only generate paths for English blog slugs at the root /blog/ route
  const enSlugs = posts
    .filter(p => p.id.startsWith('en/'))
    .map(p => p.id.split('/')[1]);
  return enSlugs.map(slug => ({
    params: { slug }
  }));
}

const lang = Astro.currentLocale || 'en';
const { slug } = Astro.params;

let post = await getEntry('blog', `${lang}/${slug}`);
if (!post) {
  post = await getEntry('blog', `en/${slug}`);
}

if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content } = await render(post);

// Build the blog slug map for language switching
// Uses the numeric id in frontmatter to find the equivalent blog in each language
const blogId = post.data.id;
const allPosts = await getCollection('blog');
const blogSlugMap = {};
for (const p of allPosts) {
  if (p.data.id === blogId) {
    const rawLang = p.id.split('/')[0];
    const pLang = rawLang.toLowerCase() === 'ar-ma' ? 'ar-MA' : rawLang;
    const pSlug = p.id.split('/')[1];
    blogSlugMap[pLang] = pSlug;
  }
}

// Build related articles from English posts with the same badge (max 6, excluding current)
// Deterministically sorted and rotated by blogId so every post receives multiple incoming internal links
const enPosts = allPosts
  .filter(p => p.id.startsWith('en/') && p.data.id !== blogId)
  .sort((a, b) => (a.data.id || 0) - (b.data.id || 0));
const sameBadge = enPosts.filter(p => p.data.badge === post.data.badge);
const otherPosts = enPosts.filter(p => p.data.badge !== post.data.badge);
const rotate = (arr, offset) => arr.length ? [...arr.slice(offset % arr.length), ...arr.slice(0, offset % arr.length)] : [];
const relatedPool = [...rotate(sameBadge, blogId || 0), ...rotate(otherPosts, (blogId || 0) * 3)];
const relatedPosts = relatedPool.slice(0, 6).map(p => ({
  title: p.data.title,
  slug: p.id.split('/')[1],
  badge: p.data.badge,
  image: p.data.image,
}));

// Extract scientific citations for GEO & E-E-A-T schema
const rawBody = post.body || '';
const citationRegex = /href=["'](https:\/\/(?:pubmed\.ncbi\.nlm\.nih\.gov|doi\.org)[^"']+)["'][^>]*>([^<]+)<\/a>/g;
const citations: Array<{ "@type": string; name: string; url: string }> = [];
const seenCitationUrls = new Set<string>();
for (const match of rawBody.matchAll(citationRegex)) {
  const url = match[1].trim();
  const name = match[2].trim().replace(/\s*—\s*PubMed.*$/i, '').trim() || 'Scientific Citation';
  if (!seenCitationUrls.has(url)) {
    seenCitationUrls.add(url);
    citations.push({
      "@type": "CreativeWork",
      "name": name,
      "url": url,
    });
  }
}

// Stable publish date: use frontmatter publishDate, or derive from blog id
const publishDate = post.data.publishDate || '2025-06-01';

// Format date for display
const displayDate = new Date(publishDate).toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

// Calculate reading time (~200 words/min)
const contentText = post.body || '';
const wordCount = contentText.split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Generate SEO-friendly short title (strictly ≤60 chars, ideal 40-55 chars) for <title> tag
function generateShortTitle(fullTitle) {
  // Strip quotes to avoid HTML entity expansion (&#39;) in the <title> tag
  const unquoted = (fullTitle || '').replace(/['"]/g, '');
  const questionMatch = unquoted.match(/^(.+?\?)/);
  if (questionMatch && questionMatch[1].length <= 48) {
    return `${questionMatch[1]} | Klar`;
  }
  if (unquoted.length > 48) {
    let truncated = unquoted.substring(0, 48).replace(/\s+\S*$/, '');
    truncated = truncated.replace(/\b(and|or|with|the|in|for|to|of|by|at|on|from|into|over|after|before|between|under|ve|veya|y|de|et|und|e|oder|con|per|por|para|na|w|i|a|för|och|att|med|som|på|av|für|mit|von|auf|voor|van|het|een|til|og|في|من|على|إلى|عن|مع)\b$/i, '');
    truncated = truncated.replace(/[,;:\-\—\s&]+$/, '').trim();
    return `${truncated} | Klar`;
  }
  return `${unquoted} | Klar`;
}

const shortTitle = generateShortTitle(post.data.title);

// Canonical URL for this page
const siteUrl = 'https://scaningredients.com';
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

// Construct alternate URLs for each existing translation of this post
const alternateUrls: Record<string, string> = {};
for (const [l, s] of Object.entries(blogSlugMap)) {
  if (l === 'en') {
    alternateUrls[l] = `${siteUrl}/blog/${s}`;
  } else {
    alternateUrls[l] = `${siteUrl}/${l}/blog/${s}`;
  }
}
---

<Layout title={post.data.title} shortTitle={shortTitle} description={post.data.description} image={post.data.image} alternateUrls={alternateUrls}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": post.data.title,
        "description": post.data.description,
        "image": post.data.image,
        "isAccessibleForFree": true,
        "wordCount": wordCount,
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": canonicalUrl,
          "reviewedBy": {
            "@type": "Organization",
            "name": "Klar Science & Research Team"
          }
        },
        "author": {
          "@type": "Organization",
          "name": "Klar",
          "alternateName": ["PureScan AI", "Klar"],
          "url": "https://scaningredients.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://scaningredients.com/logo.png"
          }
        },
        "publisher": {
          "@type": "Organization",
          "@id": "https://scaningredients.com/#organization",
          "name": "Klar",
          "alternateName": ["PureScan AI", "Klar"],
          "url": "https://scaningredients.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://scaningredients.com/logo.png"
          }
        },
        "about": {
          "@type": "Thing",
          "name": post.data.badge
        },
        "datePublished": publishDate,
        "dateModified": publishDate,
        "inLanguage": lang,
        ...(citations.length > 0 ? { "citation": citations } : {}),
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": [".quick-answer", "article .rounded-2xl:first-of-type p", "article h3:first-of-type", "article h3:first-of-type + p", "h1"]
        }
      },
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": "https://scaningredients.com/"
          },
          {
            "@type": "ListItem",
            "position": 2,
            "name": "Blog",
            "item": "https://scaningredients.com/blog"
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": post.data.title
          }
        ]
      }
    ]
  })} />
  <div class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased selection:bg-slate-200" dir={lang === 'ar' || lang === 'ar-MA' ? 'rtl' : 'ltr'}>
    <Navbar client:load currentLang={lang} blogSlugMap={blogSlugMap} showBack={true} backUrl={lang === 'en' ? '/blog' : `/${lang}/blog`} backText="Back" />

    <main class="px-5 py-12 md:py-20 max-w-5xl mx-auto min-h-[70vh]">
      <div class="bg-white rounded-[2rem] sm:rounded-[3rem] p-6 sm:p-12 md:p-16 shadow-xl border border-slate-100 max-w-4xl mx-auto relative overflow-hidden">
        
        <a href={lang === 'en' ? '/blog' : `/${lang}/blog`} class="flex items-center gap-2 text-slate-400 hover:text-slate-900 font-bold mb-10 transition-colors w-fit group">
            <svg class="w-5 h-5 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
            Back to all articles
        </a>

        <div class="mb-10 max-w-3xl">
            <div class="flex flex-wrap items-center gap-3 mb-6">
              <span class="inline-block bg-emerald-50 px-3 py-1 rounded-full text-sm font-bold text-emerald-600 border border-emerald-100">
                  {post.data.badge}
              </span>
              <span class="text-sm text-slate-400 font-medium">
                {displayDate}
              </span>
              <span class="text-slate-300">•</span>
              <span class="text-sm text-slate-400 font-medium">
                {readingTime} min read
              </span>
            </div>
            <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
                {post.data.title}
            </h1>
        </div>

        <div class="w-full h-[300px] sm:h-[450px] rounded-3xl overflow-hidden mb-10 shadow-sm border border-slate-100">
            <img 
              src={post.data.image} 
              alt={post.data.title} 
              class="w-full h-full object-cover" 
              width="1200"
              height="675"
              loading="eager"
              fetchpriority="high"
            />
        </div>

        {/* Mid-Article Contextual CTA Banner */}
        <div class="max-w-3xl mx-auto mb-10 bg-emerald-50/80 border border-emerald-200 rounded-2xl p-4 sm:p-5 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-center sm:text-left">
            <p class="text-sm sm:text-base font-extrabold text-slate-900">Want to check your own products right now?</p>
            <p class="text-xs sm:text-sm font-medium text-slate-600">Scan any barcode or label in seconds with Klar — free on iOS &amp; Android.</p>
          </div>
          <div class="flex items-center gap-2 shrink-0 flex-wrap justify-center">
            <a href="https://apps.apple.com/app/pure-ai/id6762176490" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center bg-[#0A0A0A] text-white px-4 py-2 rounded-full text-xs font-bold hover:scale-105 transition-transform">App Store</a>
            <a href="https://play.google.com/store/apps/details?id=com.pureai.com&hl=en_GB&referrer=utm_source%3Dpurescanai_website%26utm_medium%3Dmid_article_cta%26utm_campaign%3Dorganic" target="_blank" rel="noreferrer" class="inline-flex items-center justify-center bg-[#17C37B] text-white px-4 py-2 rounded-full text-xs font-bold hover:scale-105 transition-transform">Google Play</a>
          </div>
        </div>

        <article class="max-w-3xl mx-auto">
            <Content />
        </article>

        {/* Download CTA Card */}
        <div class="max-w-3xl mx-auto mt-12 bg-gradient-to-br from-emerald-50 to-teal-50 rounded-3xl p-8 sm:p-10 border border-emerald-100 shadow-sm">
          <div class="flex flex-col sm:flex-row items-center gap-6">
            <Image src={mascotHappy} alt="Klar - Food & Cosmetic Scanner" format="webp" loading="lazy" class="w-20 h-20 sm:w-24 sm:h-24 object-contain drop-shadow-md" />
            <div class="text-center sm:text-left flex-1">
              <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 mb-2">Scan Your Products Now with Klar</h3>
              <p class="text-slate-600 font-medium text-sm sm:text-base mb-4">Download Klar (formerly PureScan AI) free and instantly detect hidden toxins, allergens, and harmful additives in your food and cosmetics.</p>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href="https://apps.apple.com/app/pure-ai/id6762176490" target="_blank" rel="noreferrer" class="btn-store inline-flex items-center justify-center gap-3 bg-slate-950 text-white px-5 py-3 rounded-2xl hover:bg-slate-900 hover:scale-105 active:scale-95 transition-all shadow-md hover:shadow-xl border border-slate-800 no-underline group whitespace-nowrap" style="text-decoration: none !important; color: #ffffff !important;">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-white flex-shrink-0 group-hover:scale-110 transition-transform"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.77 1.05-1.84.93-2.91-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.81 1.02.08 2.08-.5 2.7-1.27z"/></svg>
                  <div class="text-left leading-tight whitespace-nowrap">
                    <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider whitespace-nowrap">Download on the</span>
                    <span class="block text-sm font-bold text-white tracking-tight whitespace-nowrap">App Store</span>
                  </div>
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.pureai.com&hl=en_GB&referrer=utm_source%3Dpurescanai_website%26utm_medium%3Dblog_cta%26utm_campaign%3Dorganic" target="_blank" rel="noreferrer" class="btn-store inline-flex items-center justify-center gap-3 bg-slate-950 text-white px-5 py-3 rounded-2xl hover:bg-slate-900 hover:scale-105 active:scale-95 transition-all shadow-md hover:shadow-xl border border-slate-800 no-underline group whitespace-nowrap" style="text-decoration: none !important; color: #ffffff !important;">
                  <svg viewBox="0 0 24 24" class="w-5 h-5 flex-shrink-0 group-hover:scale-110 transition-transform" fill="none">
                    <path d="M3.6 2.2c-.4.4-.6 1-.6 1.7v16.2c0 .7.2 1.3.6 1.7l.1.1 9.1-9.1v-.2L3.7 2.1l-.1.1z" fill="#00D2FF"/>
                    <path d="M15.8 15.9l-3-3v-.2l3-3 .1.1 3.5 2c1 .6 1 1.5 0 2.1l-3.6 2z" fill="#FFCE00"/>
                    <path d="M12.8 12.7L3.6 21.9c.4.4 1 .5 1.7.1l10.5-6-3-3.3z" fill="#00E676"/>
                    <path d="M12.8 11.3l3-3.3-10.5-6C4.6 1.6 4 1.7 3.6 2.1l9.2 9.2z" fill="#FF3A44"/>
                  </svg>
                  <div class="text-left leading-tight whitespace-nowrap">
                    <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider whitespace-nowrap">GET IT ON</span>
                    <span class="block text-sm font-bold text-white tracking-tight whitespace-nowrap">Google Play</span>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>

        {/* Related Articles — Internal Linking for SEO */}
        {relatedPosts.length > 0 && (
          <div class="max-w-3xl mx-auto mt-16 pt-10 border-t border-slate-200">
            <h3 class="text-lg font-bold text-slate-900 mb-6">Related Articles</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {relatedPosts.map(rp => (
                <a href={lang === 'en' ? `/blog/${rp.slug}` : `/${lang}/blog/${rp.slug}`} class="block p-4 rounded-2xl border border-slate-100 hover:border-emerald-200 hover:bg-emerald-50/50 transition-all group">
                  <span class="inline-block text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full mb-2 border border-emerald-100">{rp.badge}</span>
                  <p class="text-sm font-semibold text-slate-800 leading-snug group-hover:text-emerald-700 transition-colors line-clamp-3">{rp.title}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </main>

    <footer class="py-12 bg-white border-t-2 border-slate-100">
        <div class="max-w-7xl mx-auto px-6 text-center">
          <div class="flex justify-center items-center gap-2 mb-6">
            <Image src={logoImg} alt="Klar" format="webp" loading="lazy" class="w-8 h-8 object-contain grayscale opacity-50" />
            <span class="font-extrabold tracking-tight text-xl italic text-slate-300">Klar</span>
          </div>
          <p class="text-slate-500 font-medium pb-4 text-sm flex flex-wrap justify-center items-center gap-y-2">
            <a href="/grading" class="hover:text-[#17C37B] transition-colors">Grading System</a>
            <span class="mx-3 hidden md:inline">•</span>
            <a href="/blog" class="hover:text-[#17C37B] transition-colors ml-3 md:ml-0">Blog</a>
            <span class="mx-3">•</span>
            <a href="/privacy" class="hover:text-[#17C37B] transition-colors">Privacy Policy</a>
            <span class="mx-3">•</span>
            <a href="/terms" class="hover:text-[#17C37B] transition-colors">Terms of Service</a>
            <span class="mx-3">•</span>
            <a href="/support" class="hover:text-[#17C37B] transition-colors">Support</a>
            <span class="mx-3">•</span>
            <a href="/docs/api" class="hover:text-[#17C37B] transition-colors">API &amp; Docs</a>
          </p>
          <p class="text-slate-400 font-medium pb-4 text-xs flex flex-wrap justify-center items-center gap-y-2">
            <span class="font-semibold text-slate-500 mr-2">Compare:</span>
            <a href="/alternatives/yuka" class="hover:text-[#17C37B] transition-colors">Klar vs Yuka</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/ewg" class="hover:text-[#17C37B] transition-colors">Klar vs EWG</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/think-dirty" class="hover:text-[#17C37B] transition-colors">Klar vs Think Dirty</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/bobby-approved" class="hover:text-[#17C37B] transition-colors">Klar vs Bobby Approved</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/clearya" class="hover:text-[#17C37B] transition-colors">Klar vs Clearya</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/incibeauty" class="hover:text-[#17C37B] transition-colors">Klar vs INCI Beauty</a>
            <span class="mx-2">•</span>
            <a href="/alternatives/trash-panda" class="hover:text-[#17C37B] transition-colors">Klar vs Trash Panda</a>
          </p>
          <p class="text-slate-400 font-medium text-xs">&copy; {new Date().getFullYear()} Klar (formerly PureScan AI). Food & Cosmetic Scanner. All rights reserved.</p>
        </div>
    </footer>
  </div>
</Layout>
