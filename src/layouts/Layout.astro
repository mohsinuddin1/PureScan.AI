---
import '../styles/global.css';
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  shortTitle?: string;
  description?: string;
  image?: string;
  alternateUrls?: Record<string, string>;
}

const {
  title = "Klar — Food & Cosmetic Scanner",
  shortTitle,
  description = "Scan food & cosmetics with Klar to detect hidden toxins, allergens, and endocrine disruptors instantly. Free AI scanner app for iOS & Android.",
  image = "https://purescan.droploop.in/og-image.png",
  alternateUrls
} = Astro.props;

// Industry-standard SEO / AEO / GEO meta description normalizer (guarantees length 25 - 145 chars, accounting for HTML entity expansion)
function formatMetaDescription(desc: string | undefined): string {
  const defaultDesc = "Scan food and cosmetics with Klar to detect hidden toxins, allergens, and endocrine disruptors instantly. Free on iOS and Android.";
  if (!desc || typeof desc !== 'string') return defaultDesc;
  
  let clean = desc
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
  
  if (clean.length < 25) return defaultDesc;
  
  // Calculate potential HTML expansion (each '&' becomes '&amp;' = +4 chars in rendered HTML attribute)
  const ampCount = (clean.match(/&/g) || []).length;
  const maxSafeLen = Math.max(70, 145 - (ampCount * 4));
  
  if (clean.length <= maxSafeLen) return clean;
  
  const sub = clean.slice(0, maxSafeLen);
  // 1. Look for a complete sentence ending between 45 and maxSafeLen chars
  const sentenceMatches = [...sub.matchAll(/[.!?。！？](\s|$)/g)];
  if (sentenceMatches.length > 0) {
    const lastMatch = sentenceMatches[sentenceMatches.length - 1];
    const cutIdx = lastMatch.index + 1;
    if (cutIdx >= 45) {
      return sub.slice(0, cutIdx).trim();
    }
  }
  
  // 2. Look for word boundary (space, comma, semicolon, CJK punctuation)
  const lastBreak = Math.max(sub.lastIndexOf(' '), sub.lastIndexOf('，'), sub.lastIndexOf('、'));
  if (lastBreak >= 45) {
    let candidate = sub.slice(0, lastBreak).trim();
    candidate = candidate.replace(/\b(and|or|with|the|in|for|to|of|by|at|on|ve|veya|y|de|et|und|e|oder|con|per|por|para|na|w|i|a)\b$/i, '').trim();
    candidate = candidate.replace(/[,;:\-\s，、]+$/, '').trim();
    if (!/[.!?。！？]$/.test(candidate) && candidate.length <= maxSafeLen - 1) {
      candidate += '.';
    }
    if (candidate.length <= maxSafeLen && candidate.length >= 25) {
      return candidate;
    }
  }
  
  return sub.slice(0, maxSafeLen - 1).trim() + '.';
}

const safeDescription = formatMetaDescription(description);

// Industry-standard SEO title normalizer (guarantees length strictly < 65 chars, ideal 40-58 chars)
function formatPageTitle(rawTitle: string | undefined): string {
  if (!rawTitle) return "Klar — Food & Cosmetic Scanner";
  
  let clean = rawTitle
    .replace(/&amp;/g, '&')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
  
  // Strip quotes to avoid &#39; expansion in <title>
  clean = clean.replace(/['"]/g, '');
  
  const ampCount = (clean.match(/&/g) || []).length;
  const maxSafeLen = Math.max(35, 62 - (ampCount * 4));
  
  if (clean.length <= maxSafeLen) return clean;
  
  let brand = '';
  let body = clean;
  if (clean.endsWith(' | Klar')) {
    body = clean.slice(0, -7).trim();
    brand = ' | Klar';
  } else if (clean.endsWith(' — Klar')) {
    body = clean.slice(0, -7).trim();
    brand = ' | Klar';
  }
  
  const availLen = maxSafeLen - brand.length;
  let sub = body.slice(0, availLen).trim();
  const lastBreak = Math.max(sub.lastIndexOf(' '), sub.lastIndexOf('—'), sub.lastIndexOf('-'));
  if (lastBreak >= 20) {
    sub = sub.slice(0, lastBreak).trim();
  }
  sub = sub.replace(/\b(and|or|with|the|in|for|to|of|by|at|on|ve|veya|y|de|et|und|e|oder|con|per|por|para|na|w|i|a)\b$/i, '').trim();
  sub = sub.replace(/[,;:\-\—\s&]+$/, '').trim();
  
  return sub + brand;
}

const safeTitle = formatPageTitle(shortTitle || title);

const lang = Astro.currentLocale || "en";
const siteUrl = "https://purescan.droploop.in";
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;

// Compute base path for hreflang alternates
const locales = ['en', 'bg', 'ar', 'ar-MA', 'cs', 'da', 'de', 'el', 'es', 'fi', 'fr', 'hu', 'it', 'ja', 'ko', 'lt', 'lv', 'nb', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'sv', 'tr', 'zh'];
const pathname = canonicalPath;
const segments = pathname.split('/').filter(Boolean);
let basePath = pathname;
if (segments.length > 0 && locales.includes(segments[0]) && segments[0] !== 'en') {
  basePath = '/' + segments.slice(1).join('/');
}

// Ensure basePath doesn't end up as just '/' so that locale paths don't get a trailing slash
if (basePath === '/') {
  basePath = '';
}

// Check if this page is a known multi-language page
const multiLangPrefixes = ['', '/blog', '/grading', '/terms', '/privacy', '/support', '/delete-account'];
const isMultiLang = multiLangPrefixes.includes(basePath) || basePath.startsWith('/alternatives/');

// Generate alternate URLs for each locale
function getAlternateUrl(locale: string): string {
  if (locale === 'en') {
    return siteUrl + (basePath || '/');
  }
  return siteUrl + '/' + locale + basePath;
}

// RFC 8288 Link response headers for AI agent discovery
if (Astro.response && Astro.response.headers) {
  Astro.response.headers.set(
    'Link',
    '</.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="describedby", </llms.txt>; rel="describedby", </.well-known/oauth-protected-resource>; rel="service-desc"'
  );
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{safeTitle}</title>
    <meta name="description" content={safeDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Apple Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6762176490" />

    <!-- AI Search / GEO: llms.txt discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs Full" />

    <!-- AI Agent Discovery: RFC 9727 API Catalog & ARD Catalog -->
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Klar" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={safeDescription} />
    <meta name="twitter:image" content={image} />

    <!-- hreflang alternate links for international SEO -->
    {alternateUrls ? (
      Object.entries(alternateUrls).map(([loc, url]) => (
        <link rel="alternate" hreflang={loc} href={url} />
      ))
    ) : isMultiLang ? (
      locales.map((locale) => (
        <link rel="alternate" hreflang={locale} href={getAlternateUrl(locale)} />
      ))
    ) : null}
    <link rel="alternate" hreflang="x-default" href={alternateUrls ? (alternateUrls['en'] || canonicalUrl) : isMultiLang ? getAlternateUrl('en') : canonicalUrl} />

    <!-- JSON-LD Structured Data: WebSite + Organization + SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://purescan.droploop.in/#website",
          "url": "https://purescan.droploop.in/",
          "name": "Klar - Food & Cosmetic Scanner",
          "alternateName": "PureScan AI",
          "description": "The smartest food scanner & cosmetic scanner in your pocket.",
          "publisher": {
            "@id": "https://purescan.droploop.in/#organization"
          },
          "inLanguage": lang
        },
        {
          "@type": "Organization",
          "@id": "https://purescan.droploop.in/#organization",
          "name": "Klar",
          "alternateName": "PureScan AI",
          "url": "https://purescan.droploop.in/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://purescan.droploop.in/logo.png"
          },
          "description": "AI-powered application for scanning food and cosmetic products to detect harmful ingredients, allergens, and ultra-processed elements.",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "url": "https://purescan.droploop.in/support"
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://purescan.droploop.in/#app",
          "name": "Klar - Food & Cosmetic Scanner",
          "alternateName": ["PureScan AI", "PureScan", "Klar"],
          "applicationCategory": "HealthApplication",
          "operatingSystem": "iOS, Android",
          "description": "AI-powered food and cosmetic ingredient scanner. Detect harmful chemicals, allergens, Nutri-Score, NOVA processing levels, and personalized health risks instantly.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "500",
            "bestRating": "5"
          }
        }
      ]
    })} />
  </head>
  <body class="bg-[#fffefb] text-slate-800 font-sans selection:bg-orange-200">
    <slot />
    <script>
      import { inject } from '@vercel/analytics';
      inject();
    </script>
    <SpeedInsights />

    <!-- WebMCP: Expose site tools to AI agents via browser modelContext -->
    <script is:inline>
      (function() {
        function registerWebMcpTools() {
          if (!('modelContext' in navigator) || !navigator.modelContext) return;
          try {
            var abortController = new AbortController();
            var tools = [
              {
                name: "scan_food_ingredients",
                description: "Analyze food ingredients for harmful additives, allergens, Nutri-Score, and NOVA ultra-processing classifications",
                inputSchema: {
                  type: "object",
                  properties: {
                    ingredients: {
                      type: "string",
                      description: "Food ingredient list text or comma-separated items"
                    }
                  },
                  required: ["ingredients"]
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    query: args && args.ingredients ? args.ingredients : "",
                    summary: "Klar analysis initiated for food ingredients."
                  };
                }
              },
              {
                name: "scan_cosmetic_ingredients",
                description: "Analyze cosmetic ingredients for endocrine disruptors, allergens, and comedogenic ratings",
                inputSchema: {
                  type: "object",
                  properties: {
                    ingredients: {
                      type: "string",
                      description: "Cosmetic ingredient list text"
                    }
                  },
                  required: ["ingredients"]
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    query: args && args.ingredients ? args.ingredients : "",
                    summary: "Klar analysis initiated for cosmetic ingredients."
                  };
                }
              },
              {
                name: "get_safety_grading_criteria",
                description: "Retrieve PureScan AI safety grading criteria, Nutri-Score definitions, and NOVA processing levels",
                inputSchema: {
                  type: "object",
                  properties: {
                    category: {
                      type: "string",
                      enum: ["all", "food", "cosmetics", "nova", "nutri-score"]
                    }
                  }
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    category: (args && args.category) || "all",
                    documentationUrl: "https://purescan.droploop.in/grading"
                  };
                }
              }
            ];

            if (typeof navigator.modelContext.registerTool === 'function') {
              tools.forEach(function(tool) {
                try {
                  navigator.modelContext.registerTool(tool, { signal: abortController.signal });
                } catch (e) {}
              });
            }

            if (typeof navigator.modelContext.provideContext === 'function') {
              try {
                navigator.modelContext.provideContext({ tools: tools });
              } catch (e) {}
            }
          } catch (err) {
            console.warn('WebMCP initialization note:', err);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', registerWebMcpTools);
        } else {
          registerWebMcpTools();
        }
      })();
    </script>
  </body>
</html>
