---
import '../styles/global.css';
import SpeedInsights from "@vercel/speed-insights/astro";
import StickyAppBanner from '../components/StickyAppBanner.jsx';

interface Props {
  title?: string;
  shortTitle?: string;
  description?: string;
  image?: string;
  alternateUrls?: Record<string, string>;
  noindex?: boolean;
}

const {
  title = "Klar — Food & Cosmetic Scanner",
  shortTitle,
  description = "Scan food & cosmetics with Klar to detect hidden toxins, allergens, and endocrine disruptors instantly. Free AI scanner app for iOS & Android.",
  image = "https://scaningredients.com/og-image.png",
  alternateUrls,
  noindex = false
} = Astro.props;

const locales = ['en', 'bg', 'ar', 'ar-MA', 'cs', 'da', 'de', 'el', 'es', 'fi', 'fr', 'hu', 'it', 'ja', 'ko', 'lt', 'lv', 'nl', 'no', 'pl', 'pt', 'ro', 'ru', 'sv', 'tr', 'zh'];
const siteUrl = "https://scaningredients.com";
const canonicalPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const segments = canonicalPath.split('/').filter(Boolean);
const detectedPathLocale = segments.length > 0 ? locales.find(l => l.toLowerCase() === segments[0].toLowerCase()) : undefined;
const lang = (Astro.params?.lang as string | undefined) || detectedPathLocale || Astro.currentLocale || "en";

// Industry-standard SEO / AEO / GEO meta description normalizer (guarantees length strictly > 100 and < 145 chars, accounting for HTML entity expansion)
function formatMetaDescription(desc: string | undefined, fallbackContext?: string, localeCode: string = 'en'): string {
  const defaultDesc = "Scan food and cosmetics with Klar AI to detect hidden toxins, allergens, and endocrine disruptors instantly. Free on iOS and Android.";
  if (!desc || typeof desc !== 'string') return defaultDesc;

  let clean = desc
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();

  if (clean.length < 25) return defaultDesc;

  const isCjk = localeCode === 'ja' || localeCode === 'zh' || localeCode === 'ko';
  const paddingByLocale: Record<string, string> = {
    en: 'Scan product barcodes and labels with Klar AI to detect hidden toxins, allergens, and harmful additives in seconds.',
    ar: 'افحص مكونات الطعام ومستحضرات التجميل فوراً عبر Klar AI لاكتشاف السموم الخفية ومسببات الحساسية وتقييم الأمان الشخصي.',
    'ar-MA': 'فحص مكونات الماكلة ومستحضرات التجميل بسرعة مع Klar AI باش تكتشف السموم الخفية ومسببات الحساسية وتحمي صحتك.',
    bg: 'Сканирайте храни и козметика с Klar AI, за да откриете скрити токсини, алергени и вредни добавки за секунди.',
    cs: 'Skenujte potraviny a kosmetiku s Klar AI a okamžitě odhalte skryté toxiny, alergeny a škodlivé přísady ve složení.',
    da: 'Scan mad og kosmetik med Klar AI for øjeblikkeligt at opdage skjulte toksiner, allergener og skadelige tilsætningsstoffer.',
    de: 'Scannen Sie Lebensmittel und Kosmetik mit Klar AI, um versteckte Schadstoffe, Allergene und schädliche Zusätze sofort zu erkennen.',
    el: 'Σαρώστε τρόφιμα και καλλυντικά με το Klar AI για να εντοπίσετε άμεσα κρυφές τοξίνες, αλλεργιογόνα και επιβλαβή πρόσθετα.',
    es: 'Escanea alimentos y cosméticos con Klar AI para detectar toxinas ocultas, alérgenos y aditivos dañinos al instante.',
    fi: 'Skannaa elintarvikkeet ja kosmetiikka Klar AI:lla tunnistaaksesi piilevät myrkyt, allergeenit ja haitalliset lisäaineet heti.',
    fr: 'Scannez aliments et cosmétiques avec Klar AI pour détecter instantanément toxines cachées, allergènes et additifs nocifs.',
    hu: 'Szkennelje az élelmiszereket és kozmetikumokat a Klar AI segítségével a rejtett toxinok és allergének azonnali felismeréséhez.',
    it: 'Scansiona alimenti e cosmetici con Klar AI per rilevare subito tossine nascoste, allergeni e additivi nocivi nelle etichette.',
    ja: 'Klar AIで食品や化粧品の原材料成分を瞬時にスキャンし、隠れた有害添加物やアレルゲン、内分泌攪乱物質を科学的に分析して、あなた専用のパーソナライズされた安全スコアと健康リスク評価を無料ですぐに確認できます。',
    ko: 'Klar AI로 식품과 화장품 성분표를 즉시 스캔하여 숨겨진 독소, 알레르기 유발 물질, 내분비계 교란물질을 과학적으로 분석하고, 개인 건강 상태와 알레르기에 맞춘 맞춤형 안전 점수를 무료로 바로 확인하세요.',
    lt: 'Nuskenuokite maisto ir kosmetikos sudėtį su Klar AI, kad akimirksniu aptiktumėte paslėptus toksinus, alergenus ir priedus.',
    lv: 'Skenējiet pārtiku un kosmētiku ar Klar AI, lai uzreiz atklātu slēptos toksīnus, alergēnus un kaitīgās piedevas.',
    nl: 'Scan voeding en cosmetica met Klar AI om verborgen gifstoffen, allergenen en schadelijke toevoegingen direct te herkennen.',
    no: 'Skann mat og kosmetikk med Klar AI for å oppdage skjulte giftstoffer, allergener og skadelige tilsetningsstoffer umiddelbart.',
    pl: 'Skanuj żywność i kosmetyki z Klar AI, aby natychmiast wykryć ukryte toksyny, alergeny oraz szkodliwe dodatki w składzie.',
    pt: 'Digitalize alimentos e cosméticos com Klar AI para detetar toxinas ocultas, alergénios e aditivos prejudiciais em segundos.',
    ro: 'Scanează alimente și cosmetice cu Klar AI pentru a detecta instantaneu toxinele ascunse, alergenii și aditivii nocivi.',
    ru: 'Сканируйте продукты и косметику с Klar AI, чтобы мгновенно выявлять скрытые токсины, аллергены и вредные добавки.',
    sv: 'Skanna mat och kosmetika med Klar AI för att omedelbart upptäcka dolda gifter, allergener och skadliga tillsatser.',
    tr: 'Klar AI ile gıda ve kozmetik ürünlerini tarayarak gizli toksinleri, alerjenleri ve zararlı katkı maddelerini anında tespit edin.',
    zh: '使用 Klar AI 即刻扫描食品与化妆品成分表，依据权威毒理学与医学数据库全面排查隐藏毒素、致敏原、内分泌干扰物与超加工添加剂，免费获取您的专属安全评分与个性化健康分析报告。',
  };

  if (clean.length < 105) {
    const contextClean = (fallbackContext || '')
      .replace(/&amp;/g, '&')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
      .replace(/\s+/g, ' ')
      .trim();
    const sep = isCjk ? '' : (/[.!?。！？]$/.test(clean) ? ' ' : '. ');
    if (contextClean && !clean.toLowerCase().includes(contextClean.slice(0, 20).toLowerCase()) && clean.length + contextClean.length + sep.length >= 105) {
      clean = `${clean}${sep}${contextClean}`;
    }
    if (clean.length < 105) {
      const extra = paddingByLocale[localeCode] || paddingByLocale.en;
      const padSep = isCjk ? '' : (/[.!?。！？]$/.test(clean) ? ' ' : '. ');
      clean = `${clean}${padSep}${extra}`;
    }
  }

  // Calculate potential HTML expansion (each '&' becomes '&amp;' = +4 chars in rendered HTML attribute)
  const ampCount = (clean.match(/&/g) || []).length;
  const maxSafeLen = Math.max(105, 144 - (ampCount * 4));

  if (clean.length <= maxSafeLen) return clean;

  const sub = clean.slice(0, maxSafeLen);
  // 1. Look for a complete sentence ending only between 105 and maxSafeLen chars so we never shorten under 101
  const sentenceMatches = [...sub.matchAll(/[.!?。！？](\s|$)/g)];
  if (sentenceMatches.length > 0) {
    const lastMatch = sentenceMatches[sentenceMatches.length - 1];
    const cutIdx = lastMatch.index + 1;
    if (cutIdx >= 105) {
      return sub.slice(0, cutIdx).trim();
    }
  }

  // 2. Look for word boundary (space, comma, semicolon, CJK punctuation) >= 105 chars
  const lastBreak = Math.max(sub.lastIndexOf(' '), sub.lastIndexOf('，'), sub.lastIndexOf('、'));
  if (lastBreak >= 105) {
    let candidate = sub.slice(0, lastBreak).trim();
    candidate = candidate.replace(/\b(and|or|with|the|in|for|to|of|by|at|on|ve|veya|y|de|et|und|e|oder|con|per|por|para|na|w|i|a)$/i, '').trim();
    candidate = candidate.replace(/[,;:\-\s，、]+$/, '').trim();
    const endPunct = isCjk ? '。' : '.';
    if (!/[.!?。！？]$/.test(candidate) && candidate.length <= maxSafeLen - 1) {
      candidate += endPunct;
    }
    if (candidate.length <= maxSafeLen && candidate.length >= 101) {
      return candidate;
    }
  }

  const endPunct = isCjk ? '。' : '.';
  return sub.slice(0, maxSafeLen - 1).trim() + endPunct;
}

const safeDescription = formatMetaDescription(description, title, lang);

// Industry-standard SEO title normalizer (guarantees length strictly < 65 chars, ideal 40-58 chars)
function formatPageTitle(rawTitle: string | undefined): string {
  if (!rawTitle) return "Klar — Food & Cosmetic Scanner";
  
  let clean = rawTitle
    .replace(/&amp;/g, '&')
    .replace(/&#39;/g, "'")
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/\s+/g, ' ')
    .trim();
  
  // Strip quotes to avoid &#39; expansion in <title>
  clean = clean.replace(/['"]/g, '');
  
  const ampCount = (clean.match(/&/g) || []).length;
  const maxSafeLen = Math.max(35, 62 - (ampCount * 4));
  
  if (clean.length <= maxSafeLen) return clean;
  
  let brand = '';
  let body = clean;
  if (clean.endsWith(' | Klar')) {
    body = clean.slice(0, -7).trim();
    brand = ' | Klar';
  } else if (clean.endsWith(' — Klar')) {
    body = clean.slice(0, -7).trim();
    brand = ' | Klar';
  }
  
  const availLen = maxSafeLen - brand.length;
  let sub = body.slice(0, availLen).trim();
  const lastBreak = Math.max(sub.lastIndexOf(' '), sub.lastIndexOf('—'), sub.lastIndexOf('-'));
  if (lastBreak >= 20) {
    sub = sub.slice(0, lastBreak).trim();
  }
  sub = sub.replace(/\b(and|or|with|the|in|for|to|of|by|at|on|ve|veya|y|de|et|und|e|oder|con|per|por|para|na|w|i|a)\b$/i, '').trim();
  sub = sub.replace(/[,;:\-\—\s&]+$/, '').trim();
  
  return sub + brand;
}

const safeTitle = formatPageTitle(shortTitle || title);

// Compute base path for hreflang alternates
const pathname = canonicalPath;
let basePath = pathname;
if (segments.length > 0 && detectedPathLocale && detectedPathLocale !== 'en') {
  basePath = '/' + segments.slice(1).join('/');
}

// Ensure basePath doesn't end up as just '/' so that locale paths don't get a trailing slash
if (basePath === '/') {
  basePath = '';
}

// Check if this page is a known multi-language page
const multiLangPrefixes = ['', '/blog', '/grading', '/support'];
const isMultiLang = multiLangPrefixes.includes(basePath);

// Generate alternate URLs for each locale
function getAlternateUrl(locale: string): string {
  if (locale === 'en') {
    return siteUrl + (basePath || '/');
  }
  return siteUrl + '/' + locale + basePath;
}

// RFC 8288 Link response headers for AI agent discovery
if (Astro.response && Astro.response.headers) {
  Astro.response.headers.set(
    'Link',
    '</.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="describedby", </llms.txt>; rel="describedby", </.well-known/oauth-protected-resource>; rel="service-desc"'
  );
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO -->
    <title>{safeTitle}</title>
    <meta name="description" content={safeDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Apple Smart App Banner -->
    <meta name="apple-itunes-app" content="app-id=6762176490" />

    <!-- AI Search / GEO: llms.txt discovery -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="LLMs Full" />

    <!-- AI Agent Discovery: RFC 9727 API Catalog & ARD Catalog -->
    <link rel="api-catalog" type="application/linkset+json" href="/.well-known/api-catalog" />
    <link rel="ai-catalog" type="application/json" href="/.well-known/ai-catalog.json" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={safeTitle} />
    <meta property="og:description" content={safeDescription} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Klar" />
    <meta property="og:locale" content={lang} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={safeTitle} />
    <meta name="twitter:description" content={safeDescription} />
    <meta name="twitter:image" content={image} />

    <!-- hreflang alternate links for international SEO -->
    {!noindex && (
      alternateUrls ? (
        Object.entries(alternateUrls).map(([loc, url]) => (
          <link rel="alternate" hreflang={loc} href={url} />
        ))
      ) : isMultiLang ? (
        locales.map((locale) => (
          <link rel="alternate" hreflang={locale} href={getAlternateUrl(locale)} />
        ))
      ) : null
    )}
    {!noindex && (
      <link rel="alternate" hreflang="x-default" href={alternateUrls ? (alternateUrls['en'] || canonicalUrl) : isMultiLang ? getAlternateUrl('en') : canonicalUrl} />
    )}

    <!-- JSON-LD Structured Data: WebSite + Organization + SoftwareApplication -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://scaningredients.com/#website",
          "url": "https://scaningredients.com/",
          "name": "Klar - Food & Cosmetic Scanner",
          "alternateName": "PureScan AI",
          "description": "The smartest food scanner & cosmetic scanner in your pocket.",
          "publisher": {
            "@id": "https://scaningredients.com/#organization"
          },
          "inLanguage": lang
        },
        {
          "@type": "Organization",
          "@id": "https://scaningredients.com/#organization",
          "name": "Klar",
          "alternateName": "PureScan AI",
          "url": "https://scaningredients.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://scaningredients.com/logo.png"
          },
          "sameAs": [
            "https://apps.apple.com/app/pure-ai/id6762176490",
            "https://play.google.com/store/apps/details?id=com.pureai.com"
          ],
          "description": "AI-powered application for scanning food and cosmetic products to detect harmful ingredients, allergens, and ultra-processed elements.",
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "customer support",
            "url": "https://scaningredients.com/support"
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://scaningredients.com/#app",
          "name": "Klar - Food & Cosmetic Scanner",
          "alternateName": ["PureScan AI", "PureScan", "Klar"],
          "applicationCategory": "HealthApplication",
          "operatingSystem": "iOS, Android",
          "url": "https://scaningredients.com/",
          "sameAs": [
            "https://apps.apple.com/app/pure-ai/id6762176490",
            "https://play.google.com/store/apps/details?id=com.pureai.com"
          ],
          "description": "AI-powered food and cosmetic ingredient scanner. Detect harmful chemicals, allergens, Nutri-Score, NOVA processing levels, and personalized health risks instantly.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          },
          "aggregateRating": {
            "@type": "AggregateRating",
            "ratingValue": "4.8",
            "ratingCount": "500",
            "bestRating": "5"
          }
        }
      ]
    })} />

    <!-- Cookieless Consent Mode v2 & Microsoft Clarity -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function(){ window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied'
      });

      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "zjtvifwi0h");
      window.clarity('consentv2', {
        ad_Storage: 'denied',
        analytics_Storage: 'denied'
      });
    </script>
  </head>
  <body class="bg-[#fffefb] text-slate-800 font-sans selection:bg-orange-200">
    <slot />
    <StickyAppBanner client:load />
    <script>
      import { inject } from '@vercel/analytics';
      import { initSiteAnalytics } from '../lib/firebase.js';
      inject();
      initSiteAnalytics();
    </script>
    <SpeedInsights />

    <!-- WebMCP: Expose site tools to AI agents via browser modelContext -->
    <script is:inline>
      (function() {
        function registerWebMcpTools() {
          if (!('modelContext' in navigator) || !navigator.modelContext) return;
          try {
            var abortController = new AbortController();
            var tools = [
              {
                name: "scan_food_ingredients",
                description: "Analyze food ingredients for harmful additives, allergens, Nutri-Score, and NOVA ultra-processing classifications",
                inputSchema: {
                  type: "object",
                  properties: {
                    ingredients: {
                      type: "string",
                      description: "Food ingredient list text or comma-separated items"
                    }
                  },
                  required: ["ingredients"]
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    query: args && args.ingredients ? args.ingredients : "",
                    summary: "Klar analysis initiated for food ingredients."
                  };
                }
              },
              {
                name: "scan_cosmetic_ingredients",
                description: "Analyze cosmetic ingredients for endocrine disruptors, allergens, and comedogenic ratings",
                inputSchema: {
                  type: "object",
                  properties: {
                    ingredients: {
                      type: "string",
                      description: "Cosmetic ingredient list text"
                    }
                  },
                  required: ["ingredients"]
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    query: args && args.ingredients ? args.ingredients : "",
                    summary: "Klar analysis initiated for cosmetic ingredients."
                  };
                }
              },
              {
                name: "get_safety_grading_criteria",
                description: "Retrieve PureScan AI safety grading criteria, Nutri-Score definitions, and NOVA processing levels",
                inputSchema: {
                  type: "object",
                  properties: {
                    category: {
                      type: "string",
                      enum: ["all", "food", "cosmetics", "nova", "nutri-score"]
                    }
                  }
                },
                execute: async function(args) {
                  return {
                    status: "success",
                    category: (args && args.category) || "all",
                    documentationUrl: "https://scaningredients.com/grading"
                  };
                }
              }
            ];

            if (typeof navigator.modelContext.registerTool === 'function') {
              tools.forEach(function(tool) {
                try {
                  navigator.modelContext.registerTool(tool, { signal: abortController.signal });
                } catch (e) {}
              });
            }

            if (typeof navigator.modelContext.provideContext === 'function') {
              try {
                navigator.modelContext.provideContext({ tools: tools });
              } catch (e) {}
            }
          } catch (err) {
            console.warn('WebMCP initialization note:', err);
          }
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', registerWebMcpTools);
        } else {
          registerWebMcpTools();
        }
      })();
    </script>
  </body>
</html>
