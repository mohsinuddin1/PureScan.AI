    if (isMobileOrTablet || !hasFineHover) return;

    var IOS_SELECTOR = 'a[href*="apps.apple.com/app/pure-ai"]';
    var ANDROID_SELECTOR = 'a[href*="play.google.com/store/apps/details?id=com.pureai.com"]';

    var popover = document.getElementById('klar-store-qr-popover');
    if (!popover) return;

    var iosWrap = popover.querySelector('[data-qr-svg="ios"]');
    var androidWrap = popover.querySelector('[data-qr-svg="android"]');
    if (!iosWrap || !androidWrap) return;

    var activeLink = null;

    function getPairedStoreType(el) {
      var link = el && el.closest ? el.closest('a[href]') : null;
      if (!link || (link.dataset && link.dataset.noQr === 'true')) return null;

      var type = null;
      if (link.matches(IOS_SELECTOR)) {
        type = 'ios';
      } else if (link.matches(ANDROID_SELECTOR)) {
        type = 'android';
      } else {
        return null;
      }

      var parent = link.parentElement;
      if (!parent) return null;

      var hasIos = parent.querySelector(IOS_SELECTOR);
      var hasAndroid = parent.querySelector(ANDROID_SELECTOR);
      if (!hasIos || !hasAndroid) return null;

      return { link: link, type: type };
    }

    function showPopover(link, type) {
      if (type === 'ios') {
        iosWrap.hidden = false;
        androidWrap.hidden = true;
      } else {
        iosWrap.hidden = true;
        androidWrap.hidden = false;
      }

      var rect = link.getBoundingClientRect();
      var cardW = popover.offsetWidth || 186;
      var cardH = popover.offsetHeight || 214;

      var left = rect.left + rect.width / 2 - cardW / 2;
      var maxLeft = Math.max(12, window.innerWidth - cardW - 12);
      left = Math.max(12, Math.min(left, maxLeft));

      var top = rect.top - cardH - 12;
      var isBelow = false;
      if (top < 12) {
        top = rect.bottom + 12;
        isBelow = true;
      }

      popover.style.left = Math.round(left) + 'px';
      popover.style.top = Math.round(top) + 'px';
      popover.classList.toggle('is-below', isBelow);
      popover.classList.add('is-visible');
      popover.setAttribute('aria-hidden', 'false');
    }

    function hidePopover() {
      activeLink = null;
      popover.classList.remove('is-visible');
      popover.setAttribute('aria-hidden', 'true');
    }

    document.addEventListener('mouseover', function (e) {
      var match = getPairedStoreType(e.target);
      if (!match) {
        if (activeLink && (!e.target || !activeLink.contains(e.target))) {
          hidePopover();
        }
        return;
      }

      if (activeLink === match.link) return;
      activeLink = match.link;
      showPopover(match.link, match.type);
    });

    document.addEventListener('mouseout', function (e) {
      if (!activeLink) return;
      if (e.relatedTarget && activeLink.contains(e.relatedTarget)) return;
      hidePopover();
    });

    window.addEventListener('scroll', hidePopover, { passive: true, capture: true });
    window.addEventListener('resize', hidePopover, { passive: true });
    window.addEventListener('blur', hidePopover);
  })();
</script>
