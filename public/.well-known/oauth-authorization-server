{
  "issuer": "https://purescan.droploop.in",
  "authorization_endpoint": "https://purescan.droploop.in/oauth/authorize",
  "token_endpoint": "https://purescan.droploop.in/oauth/token",
  "jwks_uri": "https://purescan.droploop.in/.well-known/jwks.json",
  "response_types_supported": [
    "code",
    "token"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_basic",
    "client_secret_post",
    "private_key_jwt"
  ],
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "api:read",
    "api:write",
    "scan:read"
  ],
  "service_documentation": "https://purescan.droploop.in/docs/api",
  "agent_auth": {
    "skill": "https://purescan.droploop.in/.well-known/agent-skills/auth-md/SKILL.md",
    "register_uri": "https://purescan.droploop.in/api/agent/register",
    "identity_types_supported": [
      "identity_assertion",
      "anonymous"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "bearer_token",
        "api_key"
      ],
      "claim_uri": "https://purescan.droploop.in/api/agent/claim",
      "revocation_uri": "https://purescan.droploop.in/api/agent/revoke"
    },
    "anonymous": {
      "credential_types_supported": [
        "bearer_token"
      ],
      "claim_uri": "https://purescan.droploop.in/api/agent/claim"
    },
    "events_supported": [
      "token_revocation"
    ]
  }
}
